<?xml version="1.0"?>
<robot name="cool_diff_bot_lidar_3m">

  <material name="chassis_red"><color rgba="0.8 0.0 0.0 1"/></material>
  <material name="smoked_black"><color rgba="0.1 0.1 0.1 0.85"/></material>
  <material name="tire_black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="carbon_black"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="plastic_black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="white"><color rgba="0.9 0.9 0.9 1"/></material>
  <material name="glow_red"><color rgba="1.0 0.1 0.1 1"/></material>
  <material name="silver"><color rgba="0.7 0.7 0.7 1"/></material>
  <material name="lens_glass"><color rgba="0.0 0.2 0.4 1"/></material>
  <material name="pcb_blue"><color rgba="0.0 0.0 0.8 1"/></material>
  <material name="chip_black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="component_beige"><color rgba="0.8 0.7 0.5 1"/></material>
  <material name="pin_silver"><color rgba="0.8 0.8 0.8 1"/></material>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0.05 0 0"/>
      <geometry><box size="0.14 0.16 0.05"/></geometry>
      <material name="chassis_red"/>
    </visual>
    <collision>
      <origin xyz="0.05 0 0"/>
      <geometry><box size="0.14 0.16 0.05"/></geometry>
    </collision>
    <visual>
      <origin xyz="-0.07 0 0"/>
      <geometry><box size="0.10 0.08 0.05"/></geometry>
      <material name="chassis_red"/>
    </visual>
    <collision>
      <origin xyz="-0.07 0 0"/>
      <geometry><box size="0.10 0.08 0.05"/></geometry>
    </collision>
    <visual>
      <origin xyz="-0.04 0 0"/> 
      <geometry><box size="0.06 0.12 0.05"/></geometry>
      <material name="chassis_red"/>
    </visual>
    <collision>
      <origin xyz="-0.04 0 0"/>
      <geometry><box size="0.06 0.12 0.05"/></geometry>
    </collision>
    <visual>
      <origin xyz="0.14 0 0"/> 
      <geometry><box size="0.04 0.12 0.05"/></geometry>
      <material name="chassis_red"/>
    </visual>
    <collision>
      <origin xyz="0.14 0 0"/>
      <geometry><box size="0.04 0.12 0.05"/></geometry>
    </collision>
    <visual>
      <origin xyz="-0.07 0.06 0" rpy="0 0 0.38"/>
      <geometry><box size="0.11 0.02 0.05"/></geometry>
      <material name="chassis_red"/>
    </visual>
    <visual>
      <origin xyz="-0.07 -0.06 0" rpy="0 0 -0.38"/>
      <geometry><box size="0.11 0.02 0.05"/></geometry>
      <material name="chassis_red"/>
    </visual>
    <inertial>
      <mass value="2.2"/>
      <origin xyz="-0.02 0 0"/> 
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.06"/>
  </joint>

  <link name="imu_link">
    <visual><geometry><box size="0.02 0.015 0.002"/></geometry><material name="pcb_blue"/></visual>
    <visual><origin xyz="0 0 0.0015"/><geometry><box size="0.005 0.005 0.001"/></geometry><material name="chip_black"/></visual>
    <visual><origin xyz="0.006 0.003 0.0015"/><geometry><box size="0.003 0.002 0.001"/></geometry><material name="component_beige"/></visual>
    <visual><origin xyz="-0.008 0 0.002"/><geometry><box size="0.002 0.014 0.003"/></geometry><material name="pin_silver"/></visual>
    <collision><geometry><box size="0.02 0.015 0.002"/></geometry></collision>
    <inertial><mass value="0.005"/><origin xyz="0 0 0"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.05 0 0.026"/> 
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="-0.01 0 0" rpy="0 0 0"/>
      <geometry><box size="0.03 0.04 0.03"/></geometry>
      <material name="white"/>
    </visual>
    <visual>
      <origin xyz="0.01 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.012" length="0.015"/></geometry>
      <material name="plastic_black"/>
    </visual>
    <visual>
      <origin xyz="0.018 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.01" length="0.002"/></geometry>
      <material name="lens_glass"/>
    </visual>
    <collision>
      <origin xyz="-0.02 0 0"/>
      <geometry><box size="0.05 0.04 0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="-0.05 0 0.04" rpy="0 0 3.14159"/> 
  </joint>

  <link name="camera_link_optical"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>


  <link name="spoiler">
    <visual><origin xyz="0 0 0.12"/><geometry><box size="0.05 0.22 0.005"/></geometry><material name="carbon_black"/></visual>
    <visual><origin xyz="0 0.05 0.06"/><geometry><box size="0.01 0.005 0.12"/></geometry><material name="chassis_red"/></visual>
    <visual><origin xyz="0 -0.05 0.06"/><geometry><box size="0.01 0.005 0.12"/></geometry><material name="chassis_red"/></visual>
    <visual><origin xyz="0 0.11 0.13"/><geometry><box size="0.06 0.002 0.03"/></geometry><material name="carbon_black"/></visual>
    <visual><origin xyz="0 -0.11 0.13"/><geometry><box size="0.06 0.002 0.03"/></geometry><material name="carbon_black"/></visual>
  </link>

  <joint name="spoiler_joint" type="fixed">
    <parent link="base_link"/>
    <child link="spoiler"/>
    <origin xyz="0.14 0 0.025"/> 
  </joint>

  <link name="top_plate">
    <visual><geometry><box size="0.15 0.17 0.005"/></geometry><material name="smoked_black"/></visual>
  </link>

  <joint name="top_plate_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_plate"/>
    <origin xyz="0.045 0 0.08"/>
  </joint>

  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.035" length="0.025"/></geometry><material name="plastic_black"/></visual>
    <visual><origin xyz="0 0 0.02"/><geometry><cylinder radius="0.03" length="0.015"/></geometry><material name="plastic_black"/></visual>
    <visual><origin xyz="0.028 0 0.02"/><geometry><box size="0.01 0.02 0.01"/></geometry><material name="lens_glass"/></visual>
    <collision><origin xyz="0 0 0.0075"/><geometry><cylinder radius="0.035" length="0.04"/></geometry></collision>
    <inertial><mass value="0.2"/><origin xyz="0 0 0"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="top_plate"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.015"/> 
  </joint>

  <link name="standoffs">
    <visual><origin xyz="0.11 0.07 0"/><geometry><cylinder radius="0.005" length="0.08"/></geometry><material name="silver"/></visual>
    <visual><origin xyz="0.11 -0.07 0"/><geometry><cylinder radius="0.005" length="0.08"/></geometry><material name="silver"/></visual>
    <visual><origin xyz="-0.02 0.07 0"/><geometry><cylinder radius="0.005" length="0.08"/></geometry><material name="silver"/></visual>
    <visual><origin xyz="-0.02 -0.07 0"/><geometry><cylinder radius="0.005" length="0.08"/></geometry><material name="silver"/></visual>
  </link>

  <joint name="standoff_joint" type="fixed">
    <parent link="base_link"/>
    <child link="standoffs"/>
    <origin xyz="0 0 0.04"/>
  </joint>

  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.06" length="0.04"/></geometry>
      <material name="tire_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.06" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0.06 0.10 0"/>
    <axis xyz="0 -1 0"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.06" length="0.04"/></geometry>
      <material name="tire_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.06" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0.06 -0.10 0"/>
    <axis xyz="0 -1 0"/>
  </joint>

  <link name="caster_ball">
    <visual><geometry><sphere radius="0.035"/></geometry><material name="tire_black"/></visual>
    <collision><geometry><sphere radius="0.035"/></geometry></collision>
    <inertial><mass value="0.2"/><origin xyz="0 0 0"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_ball"/>
    <origin xyz="-0.13 0 -0.025"/> 
  </joint>

  <link name="center_glow">
    <visual>
      <geometry><cylinder radius="0.04" length="0.01"/></geometry>
      <material name="glow_red"/>
    </visual>
  </link>

  <joint name="glow_joint" type="fixed">
    <parent link="base_link"/>
    <child link="center_glow"/>
    <origin xyz="0 0 0.026"/>
  </joint>

  <gazebo reference="base_link"><material>Gazebo/Red</material></gazebo>
  <gazebo reference="left_wheel"><mu1>1.0</mu1><mu2>1.0</mu2><material>Gazebo/Black</material></gazebo>
  <gazebo reference="right_wheel"><mu1>1.0</mu1><mu2>1.0</mu2><material>Gazebo/Black</material></gazebo>
  <gazebo reference="caster_ball"><mu1>0.0</mu1><mu2>0.0</mu2><material>Gazebo/Black</material></gazebo>
  <gazebo reference="spoiler"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="top_plate"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="center_glow"><material>Gazebo/RedGlow</material></gazebo>
  <gazebo reference="imu_link"><material>Gazebo/Blue</material></gazebo>

  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros></ros>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.20</wheel_separation>
      <wheel_diameter>0.12</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <gazebo reference="imu_link">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <ros>
          <remapping>~/out:=imu</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
      <pose>0 0 0 0 0 0</pose>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <material>Gazebo/White</material>
    <sensor type="depth" name="rear_depth_camera">
      <always_on>1</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      
      <camera name="camera">
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10</far>
        </clip>
        <depth_camera>
          <output>depths</output>
        </depth_camera>
      </camera>

      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>camera</namespace>
          <remapping>custom_camera/image_raw:=color/image_raw</remapping>
          <remapping>custom_camera/image_depth:=depth/image_raw</remapping>
          <remapping>custom_camera/camera_info:=color/camera_info</remapping>
          <remapping>custom_camera/camera_info_depth:=depth/camera_info</remapping>
          <remapping>custom_camera/points:=depth/points</remapping>
        </ros>

        <camera_name>camera</camera_name>
        <frame_name>camera_link_optical</frame_name>
        <hack_baseline>0.07</hack_baseline>
        <min_depth>0.1</min_depth>
        <max_depth>10.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_link">
    <material>Gazebo/FlatBlack</material>
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>3.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_head_hokuyo_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
